Windows Registry Editor Version 5.00

; =============================================================================
; QALQON ROBOT — FIX WINDOWS SERIAL MOUSE & ENUMERATOR BUG FOR LIDAR STL-19P
; 1. silabenm: Silicon Labs CP210x Serial Enumerator Filter (asosiy sababchi)
; 2. sermouse: Windows Serial Mouse drayveri
; 3. serenum:  Windows Serial Port Enumerator Filter
; Start = 4 (Disabled)
; =============================================================================

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\silabenm]
"Start"=dword:00000004

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\sermouse]
"Start"=dword:00000004

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\serenum]
"Start"=dword:00000004
