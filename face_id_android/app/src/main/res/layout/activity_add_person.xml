<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:orientation="horizontal"
    android:padding="16dp">

    <!-- Left side: Camera View & Face Frame -->
    <androidx.cardview.widget.CardView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.1"
        app:cardCornerRadius="12dp"
        app:cardBackgroundColor="@color/bg_surface"
        android:layout_marginEnd="16dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.camera.view.PreviewView
                android:id="@+id/previewViewAdd"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <uz.iiv.faceid.camera.CameraOverlayView
                android:id="@+id/overlayViewAdd"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <TextView
                android:id="@+id/tvCaptureGuide"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#AA080E14"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="📷 YUZINGIZNI KAMERA MARKAZIGA TO'G'RILANG"
                android:textColor="@color/tactical_cyan"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

    <!-- Right side: Input Form -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.9"
        android:background="@drawable/card_bg"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="YANGI SHAXSNI RO'YXATGA OLISH"
            android:textColor="@color/tactical_cyan"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ism va Familiya:"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etFullName"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/edit_text_bg"
            android:hint="Masalan: Qo'ldoshev Sarvar"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:textSize="14sp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lavozim / Tashkilot:"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etRole"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/edit_text_bg"
            android:hint="Masalan: IIV Xodimi / Muhandis"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:textSize="14sp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvQualityStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Holat: Yuz qidirilmoqda..."
            android:textColor="@color/tactical_amber"
            android:textSize="13sp"
            android:layout_marginBottom="20dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btnCaptureAndSave"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/tactical_btn_bg"
            android:text="📸 BIOMETRIK RO'YXATGA OLISH"
            android:textColor="@color/tactical_green"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnCancel"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/edit_text_bg"
            android:text="BEKOR QILISH"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />
    </LinearLayout>

</LinearLayout>
