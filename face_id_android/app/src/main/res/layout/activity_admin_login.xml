<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <androidx.cardview.widget.CardView
        android:layout_width="400dp"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardBackgroundColor="@color/bg_surface"
        app:cardElevation="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="center_horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔒 ADMINISTRATOR AUTORIZATSIYASI"
                android:textColor="@color/tactical_cyan"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Boshqaruv paneliga kirish uchun xavfsizlik PIN-kodini kiriting"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textAlignment="center"
                android:layout_marginBottom="24dp" />

            <EditText
                android:id="@+id/etAdminPin"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/edit_text_bg"
                android:gravity="center"
                android:hint="• • • • • •"
                android:inputType="numberPassword"
                android:letterSpacing="0.4"
                android:maxLength="6"
                android:textColor="@color/tactical_green"
                android:textColorHint="@color/text_muted"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/tvPinError"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PIN noto'g'ri kiritildi!"
                android:textColor="@color/tactical_red"
                android:textSize="12sp"
                android:visibility="gone"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/btnSubmitPin"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/tactical_btn_bg"
                android:text="KIRISH"
                android:textColor="@color/tactical_cyan"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp" />

            <Button
                android:id="@+id/btnCancelPin"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/edit_text_bg"
                android:text="BEKOR QILISH"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>
