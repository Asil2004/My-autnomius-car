<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="20dp">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/tactical_btn_bg"
            android:text="⬅ ORQAGA"
            android:textColor="@color/tactical_cyan"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="SHAXS BIOMETRIK MA'LUMOTLARI"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginStart="16dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Left: Image & Main Info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="@drawable/card_bg"
            android:padding="20dp"
            android:layout_marginEnd="16dp">

            <ImageView
                android:id="@+id/ivDetailPhoto"
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:scaleType="centerCrop"
                android:background="#1E293B"
                android:src="@mipmap/ic_launcher"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/tvDetailName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Qo'ldoshev Sarvar"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDetailRole"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="IIV Xodimi"
                android:textColor="@color/tactical_cyan"
                android:textSize="15sp"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/tvDetailDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ro'yxatga olindi: 2026-11-02 12:00"
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:layout_marginTop="10dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/btnDeletePerson"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/tactical_btn_bg"
                android:text="🗑️ RO'YXATDAN O'CHIRISH"
                android:textColor="@color/tactical_red"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Right: Neural Biometric Embedding Stats -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.2"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🧬 NEYRON TARMOQ EMBEDDING TAHLILI"
                android:textColor="@color/tactical_cyan"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/tvVectorInfo"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:textColor="@color/tactical_green"
                android:textSize="12sp"
                android:background="#0A1118"
                android:padding="12dp"
                android:text="Model: MobileFaceNet\nEmbedding Dimensions: 192 Float32 values\nL2-Normalized: Yes\nSample vector:\n[0.0821, -0.1420, 0.0543, ...]" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
