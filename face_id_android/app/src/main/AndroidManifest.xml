<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.camera" android:required="true" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".FaceIdApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="QALQON Face ID"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.QalqonFaceID">

        <!-- 1. Main Robot Camera Screen (LAUNCHER) -->
        <activity
            android:name=".ui.main.MainActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 2. Add Person Screen -->
        <activity
            android:name=".ui.add.AddPersonActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape" />

        <!-- 3. Registered People Screen -->
        <activity
            android:name=".ui.list.RegisteredPeopleActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape" />

        <!-- 4. Person Details Screen -->
        <activity
            android:name=".ui.details.PersonDetailsActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape" />

        <!-- 5. Recognition Settings Screen -->
        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape" />

        <!-- 6. Administrator Login Screen -->
        <activity
            android:name=".ui.admin.AdminLoginActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape" />

    </application>

</manifest>
