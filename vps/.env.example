# 1. Sizning VPS ga biriktirilgan domeningiz (https:// siz yozing)
QALQON_DOMAIN=qalqon.sizning-domeningiz.uz

# 2. Robot (Raspberry Pi 5) ulanishi uchun maxfiy kalit (kamida 24 belgi!)
# Generatsiya qilish: openssl rand -hex 24
QALQON_ROBOT_TOKEN=BU_YERGA_UZUN_MAXFIY_TOKEN_YOZING

# 3. Standart robot ID
QALQON_DEFAULT_ROBOT_ID=QALQON-01
