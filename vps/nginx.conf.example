# Agar VPS da Nginx allaqachon o'rnatilgan bo'lsa (Caddy o'rniga):
# 1. Ushbu faylni /etc/nginx/sites-available/qalqon ga nusxalang
# 2. qalqon.sizning-domeningiz.uz ni o'z domeningizga almashtiring
# 3. sudo ln -s /etc/nginx/sites-available/qalqon /etc/nginx/sites-enabled/
# 4. sudo certbot --nginx -d qalqon.sizning-domeningiz.uz
# 5. sudo systemctl reload nginx

server {
    listen 80;
    server_name qalqon.sizning-domeningiz.uz;

    # WebSocket va MJPEG oqimlarida uzilish bo'lmasligi uchun timeoutlar
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;

        # WebSocket upgrade (/ws va /ws/robot uchun shart!)
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # MJPEG video oqimlari kechikmasligi uchun buferni o'chirish!
        proxy_buffering off;
        proxy_cache off;
        chunked_transfer_encoding on;
    }
}
