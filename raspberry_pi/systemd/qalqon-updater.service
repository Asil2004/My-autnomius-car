[Unit]
Description=QALQON v1.0 — Autonomous OTA Git Auto-Updater & Rollback Watchdog
After=network-online.target qalqon-core.service
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/My-autnomius-car/raspberry_pi
ExecStart=/usr/bin/python3 /home/pi/My-autnomius-car/raspberry_pi/qalqon_ota_updater.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
