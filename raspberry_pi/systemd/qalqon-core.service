[Unit]
Description=QALQON v1.0 — Autonomous Patrol Robot Core Brain Service
After=network-online.target time-sync.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/My-autnomius-car/raspberry_pi
ExecStartPre=/bin/bash -c "sudo chmod 666 /dev/ttyACM* /dev/ttyUSB* /dev/video* 2>/dev/null || true"
ExecStart=/usr/bin/python3 /home/pi/My-autnomius-car/raspberry_pi/qalqon_brain.py
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
