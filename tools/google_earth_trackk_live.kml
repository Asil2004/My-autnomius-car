<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
  <Folder>
    <name>Qalqon Robot - Real-time Kinematic GNSS Tracking</name>
    <open>1</open>
    <description>
      <![CDATA[
        <h3>🛡️ Qalqon v1.0 — 3D Jonli Sun'iy Yo'ldosh Kuzatuvi</h3>
        <p>Ushbu fayl Google Earth dasturiga Trackk Cloud Hub orqali real-vaqt rejimida har 2 soniyada robotning aniq santimetrli RTK koordinatasini uzatadi.</p>
        <p><b>Server:</b> https://trackk-gl6l.onrender.com/api.php?action=robot</p>
      ]]>
    </description>

    <!-- Jonli yangilanuvchi Network Link -->
    <NetworkLink>
      <name>Jonli Robot Pozitsiyasi (Har 2 soniyada yangilanadi)</name>
      <visibility>1</visibility>
      <open>1</open>
      <refreshVisibility>1</refreshVisibility>
      <flyToView>1</flyToView>
      <Link>
        <href>https://trackk-gl6l.onrender.com/api.php?action=robot_raw</href>
        <refreshMode>onInterval</refreshMode>
        <refreshInterval>2</refreshInterval>
      </Link>
    </NetworkLink>
  </Folder>
</kml>
